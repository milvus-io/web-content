  "paths": {
    "/v2/usage/query": {
      "post": {
        "summary": "Query Daily Usage",
        "deprecated": false,
        "description": "Queries the daily usage of the specified organization in the specified time period. The current user should be an organization owner or a billing admin.",
        "x-i18n": {
          "zh-CN": {
            "summary": "查询日用量",
            "description": "本接口查询指定组织指定时间段的日用量。当前用户须为组织所有者或计费管理员。"
          },
          "ja-JP": {
            "summary": "日次使用量を照会",
            "description": "指定した期間における、指定した組織の日次使用量を照会します。現在のユーザーは組織オーナーまたは請求管理者である必要があります。"
          }
        },
        "tags": [
          "Usage (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンは、適切な権限を持つ API key である必要があります。"
              }
            },
            "x-i18n-langs": [
              "zh-CN"
            ]
          }
        ],
        "requestBody": {
          "description": "The request body to query the daily usage of the organization.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "description": "The start time of the query period, in the format of `YYYY-MM-DD`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "查询时间段开始日期，格式为 `YYYY-MM-DD`。"
                      },
                      "ja-JP": {
                        "description": "照会期間の開始時刻です。形式は `YYYY-MM-DD` です。"
                      }
                    }
                  },
                  "end": {
                    "type": "string",
                    "description": "The end time of the query period, in the format of `YYYY-MM-DD`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "查询时间段结束日期，格式为 `YYYY-MM-DD`。"
                      },
                      "ja-JP": {
                        "description": "照会期間の終了時刻です。形式は `YYYY-MM-DD` です。"
                      }
                    }
                  }
                }
              },
              "example": {
                "start": "2024-01-01T00:00:00Z",
                "end": "2024-02-0100:00:00Z"
              }
            }
          },
          "x-i18n": {
            "ja-JP": {
              "description": "組織の日次使用量を照会するためのリクエスト本文です。"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the detailed daily usage of the specified organization in the specified time period.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回指定组织指定时间段的日用量详情。"
              },
              "ja-JP": {
                "description": "指定した期間における、指定した組織の日次使用量の詳細を返します。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "x-tab-label": "success",
                      "description": "Returns the detailed daily usage of the organization in the specified time period.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回指定组织指定时间段的日用量详情。"
                        },
                        "ja-JP": {
