                            },
                            "ja-JP": {
                              "description": "使用量照会の結果です。照会した全期間が 1 回のレスポンスで返されます。"
                            }
                          },
                          "properties": {
                            "results": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "intervalStart": {
                                    "type": "string",
