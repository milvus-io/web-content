  "paths": {
    "/v2/usage/query": {
      "post": {
        "summary": "Query Daily Usage",
        "deprecated": false,
        "description": "Queries the daily usage of the specified organization in the specified time period. The current user should be an organization owner or a billing admin.",
        "x-i18n": {
          "zh-CN": {
            "summary": "查询日用量",
            "description": "本接口查询指定组织指定时间段的日用量。当前用户须为组织所有者或计费管理员。"
          },
          "ja-JP": {
            "summary": "日次使用量を照会",
            "description": "指定した期間における、指定した組織の日次使用量を照会します。現在のユーザーは組織オーナーまたは請求管理者である必要があります。"
          }
        },
        "tags": [
          "Usage (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンは、適切な権限を持つ API key である必要があります。"
              }
            },
            "x-i18n-langs": [
              "zh-CN"
            ]
          }
        ],
        "requestBody": {
          "description": "The request body to query the daily usage of the organization.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The start of the query period, in RFC 3339 format (for example, `2026-09-16T00:00:00Z`). Must be midnight UTC. A non-UTC offset is converted to UTC first, which shifts the day. A start that is not midnight UTC silently returns that day's bucket with an empty `items` array and a `total` of `0`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "查询时间段的开始时间，采用 RFC 3339 格式（例如 `2026-09-16T00:00:00Z`）。必须为 UTC 零点整。非 UTC 时区偏移会先被换算为 UTC，日期随之偏移。开始时间不是 UTC 零点时，接口不报错，静默返回当天 `items` 为空、`total` 为 `0` 的日区间。"
                      },
                      "ja-JP": {
                        "description": "照会期間の開始時刻です。RFC 3339 形式（例: `2026-09-16T00:00:00Z`）で指定します。UTC の 0 時ちょうどである必要があります。UTC 以外のオフセットは先に UTC へ変換され、日付がずれます。開始時刻が UTC 0 時でない場合、エラーにはならず、その日の `items` が空で `total` が `0` の区間が返されます。"
                      }
                    }
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The end of the query period, in RFC 3339 format (for example, `2026-09-17T00:00:00Z`). The end date is inclusive: setting `end` equal to `start` returns a single daily bucket.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "查询时间段的结束时间，采用 RFC 3339 格式（例如 `2026-09-17T00:00:00Z`）。结束日期为包含边界：`end` 与 `start` 相同时仅返回一个日区间。"
                      },
                      "ja-JP": {
                        "description": "照会期間の終了時刻です。RFC 3339 形式（例: `2026-09-17T00:00:00Z`）で指定します。終了日は境界に含まれます。`end` を `start` と同じ値にすると、1 日分の区間のみ返されます。"
                      }
                    }
                  }
                }
              },
              "example": {
                "start": "2024-01-01T00:00:00Z",
                "end": "2024-02-01T00:00:00Z"
              }
            }
          },
          "x-i18n": {
            "ja-JP": {
              "description": "組織の日次使用量を照会するためのリクエスト本文です。"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the detailed daily usage of the specified organization in the specified time period.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回指定组织指定时间段的日用量详情。"
              },
              "ja-JP": {
                "description": "指定した期間における、指定した組織の日次使用量の詳細を返します。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "x-tab-label": "success",
                      "description": "Returns the detailed daily usage of the organization in the specified time period.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回指定组织指定时间段的日用量详情。"
                        },
                        "ja-JP": {
