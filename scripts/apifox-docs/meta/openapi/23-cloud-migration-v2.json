{
  "openapi": "3.0.1",
  "info": {
    "title": "Restful API copy",
    "description": "",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Cloud Migration (V2)",
      "x-include-target": [
        "zilliz"
      ],
      "x-i18n": {
        "zh-CN": {
          "name": "Migration (V2)"
        }
      }
    }
  ],
  "paths": {
    "/v2/migrations/startByRemote": {
      "post": {
        "summary": "Migrate from Remote",
        "description": "Starts a migration from a remote bucket to the specified cluster.",
        "x-i18n": {
          "zh-CN": {
            "summary": "从远端迁移",
            "description": "本接口用于从远端存储桶迁移数据到指定集群。"
          },
          "ja-JP": {
            "summary": "Remote から移行",
            "description": "リモートバケットから指定したクラスターへの移行を開始します。"
          }
        },
        "tags": [
          "Cloud Migration (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンには、適切な権限を持つ API key を使用する必要があります。"
              }
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "description": "Use `application/json`.",
            "required": false,
            "example": "application/json",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "使用 `application/json`。"
              },
              "ja-JP": {
                "description": "`application/json` を使用します。"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "description": "Source storage configuration.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "源存储配置。"
                      },
                      "ja-JP": {
                        "description": "ソースストレージの設定。"
                      }
                    },
                    "properties": {
                      "cloud": {
                        "type": "string",
                        "description": "Cloud provider.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "云提供商。"
                          },
                          "ja-JP": {
                            "description": "クラウドプロバイダー。"
                          }
                        }
                      },
                      "region": {
                        "type": "string",
                        "description": "Cloud region.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "云地域。"
                          },
                          "ja-JP": {
                            "description": "クラウドリージョン。"
                          }
                        }
                      },
                      "bucketName": {
                        "type": "string",
                        "description": "Name of the source bucket.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "源存储桶名称。"
                          },
                          "ja-JP": {
                            "description": "ソースバケットの名前。"
                          }
                        }
                      },
                      "path": {
                        "type": "string",
                        "description": "Path within the source bucket.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "源存储桶内的路径。"
                          },
                          "ja-JP": {
                            "description": "ソースバケット内のパス。"
                          }
                        }
                      },
                      "objectUrl": {
                        "type": "string",
                        "description": "Object URL.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "对象 URL。"
                          },
                          "ja-JP": {
                            "description": "オブジェクト URL。"
                          }
                        }
                      },
                      "accessKey": {
                        "type": "string",
                        "description": "Access key.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "访问密钥。"
                          },
                          "ja-JP": {
                            "description": "アクセスキー。"
                          }
                        }
                      },
                      "secretKey": {
                        "type": "string",
                        "description": "Secret key.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "私有密钥。"
                          },
                          "ja-JP": {
                            "description": "シークレットキー。"
                          }
                        }
                      },
                      "token": {
                        "type": "string",
                        "description": "Security token.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "安全令牌。"
                          },
                          "ja-JP": {
                            "description": "セキュリティトークン。"
                          }
                        }
                      },
                      "stageName": {
                        "type": "string",
                        "description": "Stage name.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "Stage 名称。"
                          },
                          "ja-JP": {
                            "description": "ステージ名。"
                          }
                        }
                      },
                      "dataPath": {
                        "type": "string",
                        "description": "Data path.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "数据路径。"
                          },
                          "ja-JP": {
                            "description": "データパス。"
                          }
                        }
                      }
                    }
                  },
                  "destination": {
                    "type": "object",
                    "description": "Destination cluster configuration.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "目标集群配置。"
                      },
                      "ja-JP": {
                        "description": "宛先クラスターの設定。"
                      }
                    },
                    "properties": {
                      "clusterId": {
                        "type": "string",
                        "description": "ID of the destination cluster.",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "目标集群 ID。"
                          },
                          "ja-JP": {
                            "description": "宛先クラスターの ID。"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the ID of the created migration job.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回已创建迁移任务的 ID。"
              },
              "ja-JP": {
                "description": "作成された移行ジョブの ID を返します。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "x-tab-label": "success",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "jobId": {
                              "type": "string",
                              "description": "ID of the created migration job.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "已创建迁移任务的 ID。"
                                },
                                "ja-JP": {
                                  "description": "作成された移行ジョブの ID。"
                                }
                              }
                            }
                          },
                          "description": "Response payload which contains the ID of the created migration job.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应载荷，包含已创建迁移任务的 ID。"
                            },
                            "ja-JP": {
                              "description": "作成された移行ジョブの ID を含むレスポンスペイロード。"
                            }
                          }
                        }
                      }
                    },
                    {
                      "x-tab-label": "failure",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "错误描述。"
                            },
                            "ja-JP": {
                              "description": "エラーメッセージ。"
                            }
                          }
                        }
                      },
                      "description": "A failure response.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "失败响应。"
                        },
                        "ja-JP": {
                          "description": "失敗レスポンス。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2/migrations/toExisting": {
      "post": {
        "summary": "Migrate to Existing Cluster",
        "deprecated": false,
        "description": "Migrate data from a cluster to another.",
        "x-i18n": {
          "zh-CN": {
            "summary": "迁移数据至现有集群",
            "description": "本接口可将数据从一个集群迁移至另一个集群。"
          },
          "ja-JP": {
            "summary": "既存の Cluster へ移行",
            "description": "ある cluster から別の cluster へデータを移行します。"
          }
        },
        "tags": [
          "Cloud Migration (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンには、適切な権限を持つ API key を使用する必要があります。"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a job ID.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "x-tab-label": "success",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "jobId": {
                              "type": "string",
                              "description": "The ID of the job that has been created upon your request.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "根据请求创建的任务 ID。"
                                },
                                "ja-JP": {
                                  "description": "リクエストによって作成された job の ID。"
                                }
                              }
                            }
                          },
                          "x-i18n": {
                            "zh-CN": {
                              "description": "任务信息。"
                            },
                            "ja-JP": {
                              "description": "Job の情報。"
                            }
                          }
                        }
                      }
                    },
                    {
                      "x-tab-label": "failure",
                      "description": "Returns an error message.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回错误消息。"
                        },
                        "ja-JP": {
                          "description": "エラーメッセージを返します。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ],
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "错误描述。"
                            },
                            "ja-JP": {
                              "description": "エラーメッセージ。"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "1": {
                    "summary": "success",
                    "x-target-response": "OPTION 1",
                    "value": {
                      "code": 0,
                      "data": {
                        "jobId": "job-xxxxxxxxxxxxxxxxxxxxxx"
                      }
                    }
                  },
                  "2": {
                    "summary": "failure",
                    "x-target-response": "OPTION 2",
                    "value": {
                      "code": 21119,
                      "message": "The apikey is illegal."
                    }
                  }
                }
              }
            },
            "x-i18n": {
              "ja-JP": {
                "description": "Job ID を返します。"
              },
              "zh-CN": {
                "description": "返回任务 ID。"
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "description": "The source cluster information.",
                    "properties": {
                      "clusterId": {
                        "type": "string",
                        "description": "The ID of the source cluster.",
                        "example": "inxx-xxxxxxxxxxxxxxxxx",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "源集群 ID。"
                          },
                          "ja-JP": {
                            "description": "移行元 cluster の ID。"
                          }
                        }
                      }
                    },
                    "required": [
                      "clusterId"
                    ],
                    "x-i18n": {
                      "zh-CN": {
                        "description": "源集群信息。"
                      },
                      "ja-JP": {
                        "description": "移行元 cluster の情報。"
                      }
                    }
                  },
                  "destination": {
                    "type": "object",
                    "description": "The destination cluster information.",
                    "properties": {
                      "clusterId": {
                        "type": "string",
                        "description": "The ID of the destination cluster.",
                        "example": "inxx-xxxxxxxxxxxxxxxxxx",
                        "x-i18n": {
                          "zh-CN": {
                            "description": "目标集群 ID。"
                          },
                          "ja-JP": {
                            "description": "移行先 cluster の ID。"
                          }
                        }
                      }
                    },
                    "required": [
                      "clusterId"
                    ],
                    "x-i18n": {
                      "zh-CN": {
                        "description": "目标集群信息。"
                      },
                      "ja-JP": {
                        "description": "移行先 cluster の情報。"
                      }
                    }
                  },
                  "dbCollections": {
                    "type": "array",
                    "description": "The collections that need to be migrated.",
                    "items": {
                      "type": "object",
                      "description": "Collection information.",
                      "properties": {
                        "dbName": {
                          "type": "string",
                          "description": "The name of the source database. This is optional. If left unspecified, the default database applies.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "源数据库名称。该字段可选；未指定时使用默认数据库。"
                            },
                            "ja-JP": {
                              "description": "移行元 database の名前。このフィールドは省略可能です。省略した場合は default database が使用されます。"
                            }
                          }
                        },
                        "destDbName": {
                          "type": "string",
                          "description": "The name of the destination database.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "目标数据库名称。"
                            },
                            "ja-JP": {
                              "description": "移行先 database の名前。"
                            }
                          }
                        },
                        "collections": {
                          "type": "array",
                          "description": "The names of the collections that need to be migrated in the above specified source database. If this is left unspecified, all collections in the source database will be migrated.",
                          "items": {
                            "type": "object",
                            "description": "A list of collection names.",
                            "properties": {
                              "collectionName": {
                                "type": "string",
                                "description": "A collection name.",
                                "x-i18n": {
                                  "zh-CN": {
                                    "description": "Collection 名称。"
                                  },
                                  "ja-JP": {
                                    "description": "Collection の名前。"
                                  }
                                }
                              }
                            },
                            "x-i18n": {
                              "zh-CN": {
                                "description": "Collection 名称列表。"
                              },
                              "ja-JP": {
                                "description": "Collection 名の一覧。"
                              }
                            }
                          },
                          "x-i18n": {
                            "zh-CN": {
                              "description": "上述源数据库中需要迁移的 Collection 名称。未指定时，将迁移源数据库中的所有 Collection。"
                            },
                            "ja-JP": {
                              "description": "上記の移行元 database で移行する collection の名前。省略した場合は、移行元 database 内のすべての collection が移行されます。"
                            }
                          }
                        }
                      },
                      "x-i18n": {
                        "zh-CN": {
                          "description": "Collection 信息。"
                        },
                        "ja-JP": {
                          "description": "Collection の情報。"
                        }
                      }
                    },
                    "x-i18n": {
                      "zh-CN": {
                        "description": "需要迁移的 Collection。"
                      },
                      "ja-JP": {
                        "description": "移行する collection。"
                      }
                    }
                  }
                },
                "required": [
                  "source",
                  "destination"
                ]
              },
              "example": {
                "source": {
                  "clusterId": "inxx-xxxxxxxxxxxxxxx"
                },
                "destination": {
                  "clusterId": "inxx-xxxxxxxxxxxxxxx"
                },
                "dbCollections": [
                  {
                    "collections": [
                      {
                        "collectionName": "medium_articles"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/v2/migrations/toNewDedicated": {
      "post": {
        "summary": "Migrate to New Dedicated Cluster",
        "deprecated": false,
        "description": "Create a dedicated cluster and migrate data from the source cluster to the new cluster.",
        "x-i18n": {
          "zh-CN": {
            "summary": "迁移数据至新集群",
            "description": "本接口可创建一个新的 Dedicated 集群，并将源集群的数据迁移到新创建的集群。"
          },
          "ja-JP": {
            "summary": "新しい Dedicated Cluster へ移行",
            "description": "Dedicated Cluster を作成し、ソースクラスターから新しいクラスターへデータを移行します。"
          }
        },
        "tags": [
          "Cloud Migration (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンには、適切な権限を持つ API key を使用する必要があります。"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "x-tab-label": "success",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "clusterId": {
                              "type": "string",
                              "description": "The ID of the destination cluster.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "目标集群 ID。"
                                },
                                "ja-JP": {
                                  "description": "移行先 cluster の ID。"
                                }
                              }
                            },
                            "username": {
                              "type": "string",
                              "description": "The username used to access the destination cluster.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "访问目标集群所使用的用户名。"
                                },
                                "ja-JP": {
                                  "description": "移行先 cluster へのアクセスに使用する username。"
                                }
                              }
                            },
                            "password": {
                              "type": "string",
                              "description": "The password used to access the destination cluster. This will be shown to you only once. You are advised to note down the password and save it in a secure place.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "访问目标集群所使用的密码。该密码仅显示一次，请记录并妥善保管。"
                                },
                                "ja-JP": {
                                  "description": "移行先 cluster へのアクセスに使用する password。この password は一度だけ表示されます。記録して安全な場所に保管してください。"
                                }
                              }
                            },
                            "jobId": {
                              "type": "string",
                              "description": "The ID of the job that has been created upon your request.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "根据请求创建的任务 ID。"
                                },
                                "ja-JP": {
                                  "description": "リクエストによって作成された job の ID。"
                                }
                              }
                            }
                          },
                          "x-i18n": {
                            "zh-CN": {
                              "description": "目标集群和迁移任务信息。"
                            },
                            "ja-JP": {
                              "description": "移行先 cluster と移行 job の情報。"
                            }
                          }
                        }
                      }
                    },
                    {
                      "x-tab-label": "failure",
                      "description": "Returns an error message.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回错误消息。"
                        },
                        "ja-JP": {
                          "description": "エラーメッセージを返します。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ],
                      "type": "object",
                      "properties": {
