{
  "openapi": "3.0.1",
  "info": {
    "title": "Restful API copy",
    "description": "",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Invoices (V2)",
      "x-include-target": [
        "zilliz"
      ],
      "x-i18n": {
        "zh-CN": {
          "name": "Invoices (V2)"
        }
      }
    }
  ],
  "paths": {
    "/v2/invoices": {
      "get": {
        "summary": "List Invoices",
        "deprecated": false,
        "description": "Lists all invoices in the organization to which the current user belongs. The current user should be an organization owner or a billing admin.",
        "x-i18n": {
          "zh-CN": {
            "summary": "查看发票列表",
            "description": "本接口列出当前用户所属组织的所有发票。当前用户须为组织所有者或计费管理员。"
          },
          "ja-JP": {
            "summary": "請求書を一覧表示",
            "description": "現在のユーザーが所属する組織内のすべての請求書を一覧表示します。現在のユーザーは組織のオーナーまたは billing admin である必要があります。"
          }
        },
        "tags": [
          "Invoices (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンは、適切な権限を持つ API key である必要があります。"
              }
            },
            "x-i18n-langs": [
              "zh-CN"
            ]
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The number of items to return in each page.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "x-i18n": {
              "zh-CN": {
                "description": "每页返回的项目数量。"
              },
              "ja-JP": {
                "description": "各ページで返される項目数。"
              }
            },
            "example": 10
          },
          {
            "name": "currentPage",
            "in": "query",
            "description": "The page number to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "x-i18n": {
              "zh-CN": {
                "description": "要返回的页码。"
              },
              "ja-JP": {
                "description": "返されるページ番号。"
              }
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of invoice records in the organization to which the current user belongs.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回当前用户所属组织的所有发票记录列表。"
              },
              "ja-JP": {
                "description": "現在のユーザーが所属する組織内の請求書レコードの一覧を返します。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "x-tab-label": "success",
                      "description": "Returns a list of invoices.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回发票列表。"
                        },
                        "ja-JP": {
                          "description": "請求書の一覧を返します。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ],
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "format": "int32",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "description": "Response payload containing the invoice records.",
                          "properties": {
                            "count": {
                              "type": "integer",
                              "format": "int32",
                              "description": "Total number of invoice records available.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "可用的 invoice 记录总数。"
                                },
                                "ja-JP": {
                                  "description": "利用可能な請求書レコードの総数。"
                                }
                              }
                            },
                            "currentPage": {
                              "type": "integer",
                              "format": "int32",
                              "description": "The page number of the returned records.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "当前返回记录的页码。"
                                },
                                "ja-JP": {
                                  "description": "返されたレコードのページ番号。"
                                }
                              }
                            },
                            "pageSize": {
                              "type": "integer",
                              "format": "int32",
                              "description": "The number of records per page.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "每页的记录数。"
                                },
                                "ja-JP": {
                                  "description": "1 ページあたりのレコード数。"
                                }
                              }
                            },
                            "invoices": {
                              "type": "array",
                              "description": "The invoice records on the current page.",
                              "items": {
                                "type": "object",
                                "description": "A single invoice record in the response payload.",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "description": "ID of the invoice.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票 ID。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書の ID。"
                                      }
                                    }
                                  },
                                  "orgId": {
                                    "type": "string",
                                    "description": "ID of the organization the invoice belongs to.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票所属组织 ID。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書が属する組織の ID。"
                                      }
                                    }
                                  },
                                  "periodStart": {
                                    "type": "string",
                                    "format": "date-time",
                                    "description": "Start of the billing period.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "账期开始时间。"
                                      },
                                      "ja-JP": {
                                        "description": "請求期間の開始日。"
                                      }
                                    }
                                  },
                                  "periodEnd": {
                                    "type": "string",
                                    "format": "date-time",
                                    "description": "End of the billing period.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "账期结束时间。"
                                      },
                                      "ja-JP": {
                                        "description": "請求期間の終了日。"
                                      }
                                    }
                                  },
                                  "invoiceDate": {
                                    "type": "string",
                                    "format": "date-time",
                                    "description": "Date when the invoice was issued.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票开具日期。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書の発行日。"
                                      }
                                    }
                                  },
                                  "dueDate": {
                                    "type": "string",
                                    "format": "date-time",
                                    "description": "Date when the invoice is due.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票到期日期。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書の支払期限。"
                                      }
                                    }
                                  },
                                  "currency": {
                                    "type": "string",
                                    "description": "Currency of the invoice amounts.",
                                    "enum": [
                                      "USD",
                                      "CNY",
                                      "EURO"
                                    ],
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票金额的币种。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書金額の通貨。"
                                      }
                                    }
                                  },
                                  "status": {
                                    "type": "string",
                                    "description": "Status of the invoice.",
                                    "enum": [
                                      "unbilled",
                                      "unconfirmed",
                                      "disputed",
                                      "unpaid",
                                      "overdue",
                                      "paid",
                                      "void"
                                    ],
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票状态。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書のステータス。"
                                      }
                                    }
                                  },
                                  "usageAmount": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Usage amount before credits and other adjustments.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "额度抵扣及其他调整前的用量金额。"
                                      },
                                      "ja-JP": {
                                        "description": "クレジットおよびその他の調整前の使用額。"
                                      }
                                    }
                                  },
                                  "creditsApplied": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Amount of credits applied to the invoice.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票中抵扣的额度金额。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書に適用されたクレジット額。"
                                      }
                                    }
                                  },
                                  "alreadyBilledAmount": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Amount already billed for the billing period.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "该账期已出账的金额。"
                                      },
                                      "ja-JP": {
                                        "description": "請求期間に対して既に請求済みの金額。"
                                      }
                                    }
                                  },
                                  "subtotal": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Subtotal before tax.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "税前小计金额。"
                                      },
                                      "ja-JP": {
                                        "description": "税抜小計。"
                                      }
                                    }
                                  },
                                  "tax": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Tax amount.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "税额。"
                                      },
                                      "ja-JP": {
                                        "description": "税額。"
                                      }
                                    }
                                  },
                                  "total": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Total amount including tax.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "含税总金额。"
                                      },
                                      "ja-JP": {
                                        "description": "税込合計額。"
                                      }
                                    }
                                  },
                                  "advancePayAmount": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Amount paid in advance applied to the invoice.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "已预付并用于抵扣发票的金额。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書に適用された前払い額。"
                                      }
                                    }
                                  },
                                  "amountDue": {
                                    "type": "integer",
                                    "format": "int64",
                                    "description": "Amount still due on the invoice.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "发票待支付金额。"
                                      },
                                      "ja-JP": {
                                        "description": "請求書の未払い残額。"
                                      }
                                    }
                                  }
                                },
                                "x-i18n": {
                                  "zh-CN": {
                                    "description": "响应负载中的单条 invoice 记录。"
                                  },
                                  "ja-JP": {
                                    "description": "レスポンスペイロード内の 1 件の請求書レコードです。"
                                  }
                                }
                              },
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "当前页的 invoice 记录。"
                                },
                                "ja-JP": {
                                  "description": "現在のページの請求書レコード。"
                                }
                              }
                            }
                          },
                          "x-i18n": {
                            "zh-CN": {
                              "description": "包含 invoice 记录的响应负载。"
                            },
                            "ja-JP": {
                              "description": "請求書レコードを含むレスポンスペイロードです。"
                            }
                          }
                        }
                      }
                    },
                    {
                      "x-tab-label": "error",
                      "description": "Returns an error message.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回错误消息。"
                        },
                        "ja-JP": {
                          "description": "エラーメッセージを返します。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ],
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "错误描述。"
                            },
                            "ja-JP": {
                              "description": "エラーメッセージ。"
                            }
                          }
                        }
                      }
                    }
                  ],
                  "description": "Response body listing invoices.",
                  "x-i18n": {
                    "zh-CN": {
                      "description": "列出 invoice 的响应体。"
                    },
                    "ja-JP": {
                      "description": "請求書の一覧を返すレスポンスボディです。"
                    }
                  }
                },
                "examples": {
                  "1": {
                    "summary": "success",
                    "x-target-response": "OPTION 1",
                    "value": {
                      "code": 0,
                      "data": {
                        "count": 1,
                        "currentPage": 1,
                        "pageSize": 10,
                        "invoices": [
                          {
                            "id": "inv-12312io23810o291",
                            "orgId": "org-xxxxxx",
                            "periodStart": "2024-01-01T00:00:00Z",
                            "periodEnd": "2024-02-01T00:00:00Z",
                            "invoiceDate": "2024-02-01T00:00:00Z",
                            "dueDate": "2024-02-01T00:00:00Z",
                            "currency": "USD",
                            "status": "unpaid",
                            "usageAmount": 52400,
                            "creditsApplied": 12400,
                            "alreadyBilledAmount": 0,
                            "subtotal": 40000,
                            "tax": 5000,
                            "total": 45000,
                            "advancePayAmount": 0,
                            "amountDue": 45000
                          }
                        ]
                      }
                    }
                  },
                  "2": {
                    "summary": "failure",
                    "x-target-response": "OPTION 2",
                    "value": {
                      "code": 21119,
                      "message": "The apikey is illegal."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/invoices/{INVOICE_ID}": {
      "get": {
        "summary": "Describe Invoice",
        "deprecated": false,
        "description": "Describes the specified invoice in the organization to which the current user belongs. The current user should be an organization owner or a billing admin.",
        "x-i18n": {
          "zh-CN": {
            "summary": "查看发票详情",
            "description": "本接口描述当前用户所属组织的指定发票。当前用户须为组织所有者或计费管理员。"
          },
          "ja-JP": {
            "summary": "請求書を説明する",
            "description": "現在のユーザーが所属する組織内の指定された請求書の詳細を取得します。現在のユーザーは組織の owner または billing admin である必要があります。"
          }
        },
        "tags": [
          "Invoices (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              },
              "ja-JP": {
                "description": "認証トークンは、適切な権限を持つ API key である必要があります。"
              }
            },
            "x-i18n-langs": [
              "zh-CN"
            ]
          },
          {
            "name": "INVOICE_ID",
            "in": "path",
            "description": "The ID of the invoice to describe.",
            "required": true,
            "example": "inv-12312io23810o291",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "要描述的发票 ID。"
              },
              "ja-JP": {
                "description": "詳細を取得する請求書の ID。"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the details of the specified invoice in the organization to which the current user belongs.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回当前用户所属组织的指定发票的详细信息。"
              },
              "ja-JP": {
                "description": "現在のユーザーが所属する組織内の指定された請求書の詳細を返します。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "x-tab-label": "success",
                      "description": "Returns the details of the specified invoice.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回指定发票的详细信息。"
                        },
                        "ja-JP": {
                          "description": "指定された請求書の詳細を返します。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ],
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "format": "int32",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            },
                            "ja-JP": {
                              "description": "レスポンスコード。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "description": "Response payload object containing the data returned for the requested invoice.",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "The ID of the invoice.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票 ID。"
                                },
                                "ja-JP": {
                                  "description": "請求書の ID。"
                                }
                              }
                            },
                            "orgId": {
                              "type": "string",
                              "description": "The ID of the organization to which the invoice belongs.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票所属组织 ID。"
                                },
                                "ja-JP": {
                                  "description": "請求書が属する組織の ID。"
                                }
                              }
                            },
                            "periodStart": {
                              "type": "string",
                              "format": "date-time",
                              "description": "The start time of the invoice period.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票帐期开始时间。"
                                },
                                "ja-JP": {
                                  "description": "請求期間の開始時刻。"
                                }
                              }
                            },
                            "periodEnd": {
                              "type": "string",
                              "format": "date-time",
                              "description": "The end time of the invoice period.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票帐期结束时间。"
                                },
                                "ja-JP": {
                                  "description": "請求期間の終了時刻。"
                                }
                              }
                            },
                            "invoiceDate": {
                              "type": "string",
                              "format": "date-time",
                              "description": "The date on which the invoice was issued.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票生成日期。"
                                },
                                "ja-JP": {
                                  "description": "請求書が発行された日付。"
                                }
                              }
                            },
                            "dueDate": {
                              "type": "string",
                              "format": "date-time",
                              "description": "The due date of the invoice.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票逾期时间。"
                                },
                                "ja-JP": {
                                  "description": "請求書の支払期日。"
                                }
                              }
                            },
                            "currency": {
                              "type": "string",
                              "description": "The currency of the invoice.",
                              "enum": [
                                "USD",
                                "CNY",
                                "EURO"
                              ],
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票币种。"
                                },
                                "ja-JP": {
                                  "description": "請求書の通貨。"
                                }
                              }
                            },
                            "status": {
                              "type": "string",
                              "description": "The status of the invoice.",
                              "enum": [
                                "unbilled",
                                "unconfirmed",
                                "disputed",
                                "unpaid",
                                "overdue",
                                "paid",
                                "void"
                              ],
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票状态。"
                                },
                                "ja-JP": {
                                  "description": "請求書のステータス。"
                                }
                              }
                            },
                            "usageAmount": {
                              "type": "integer",
                              "format": "int64",
                              "description": "The total amount recorded in the invoice.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "发票记录的总金额。"
                                },
                                "ja-JP": {
                                  "description": "請求書に記録された合計金額。"
                                }
                              }
