{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.com/contracts/rest-fragment-collection.schema.json",
  "title": "REST Fragment Collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "apiSurface",
    "source",
    "generator",
    "review",
    "services"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "collectionId": {"type": "string", "minLength": 1},
    "apiSurface": {"enum": ["data-plane", "control-plane"]},
    "releaseTrack": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.x$"},
    "source": {"$ref": "#/$defs/revision"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "configDigest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "configDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestDigest", "approvalDigest"],
      "properties": {
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "approvalDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fragment", "sha256", "operationCount"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "fragment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.openapi\\.json$"},
          "sha256": {"$ref": "#/$defs/digest"},
          "operationCount": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"apiSurface": {"const": "data-plane"}}},
      "then": {},
      "else": {"not": {"required": ["releaseTrack"]}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  }
}
