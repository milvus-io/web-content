{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.com/contracts/rest-upstream-ledger.schema.json",
  "title": "REST Upstream Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "isoDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "opKey": {"type": "string", "pattern": "^(get|put|post|delete|patch|options|head|trace) /[^\\s]+$"},
    "fragmentFile": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.json$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opKey", "source", "firstSeenPin", "firstSeenAt", "classification", "reason", "owner", "decidedAt"],
      "properties": {
        "opKey": {"$ref": "#/$defs/opKey"},
        "source": {"$ref": "#/$defs/sourceId"},
        "firstSeenPin": {"$ref": "#/$defs/sha1"},
        "firstSeenAt": {"$ref": "#/$defs/isoDate"},
        "classification": {"enum": ["adopted", "rejected", "deferred", "external"]},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "decidedAt": {"$ref": "#/$defs/isoDate"},
        "fragment": {"$ref": "#/$defs/fragmentFile"}
      }
    }
  }
}
