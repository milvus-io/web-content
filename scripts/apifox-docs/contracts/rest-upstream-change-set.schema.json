{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.com/contracts/rest-upstream-change-set.schema.json",
  "title": "REST Upstream Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "diffDigest", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "source": {"$ref": "#/$defs/sourceId"},
    "diffDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "jsonPointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"},
    "fragmentFile": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.json$"},
    "lifecycleValue": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.x$"}]},
    "ledgerDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opKey", "classification", "reason", "owner"],
      "properties": {
        "opKey": {"type": "string", "pattern": "^(get|put|post|delete|patch|options|head|trace) /[^\\s]+$"},
        "classification": {"enum": ["adopted", "rejected", "deferred", "external"]},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "fragment": {"$ref": "#/$defs/fragmentFile"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diffEntryId", "kind", "evidence"],
      "properties": {
        "diffEntryId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["prose", "constraint", "title", "ledgerDraft", "lifecycle", "mirror", "addition"]},
        "evidence": {"type": "string", "minLength": 1},
        "targetFragment": {"$ref": "#/$defs/fragmentFile"},
        "opPath": {"$ref": "#/$defs/jsonPointer"},
        "value": {},
        "requiredMembership": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "ledgerDraft": {"$ref": "#/$defs/ledgerDraft"},
        "override": {"type": "boolean"},
        "overrideReason": {"type": "string", "minLength": 1}
      }
    }
  }
}
