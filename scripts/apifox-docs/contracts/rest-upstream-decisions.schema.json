{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.com/contracts/rest-upstream-decisions.schema.json",
  "title": "REST Upstream Refresh Decision (one JSONL line)",
  "description": "One stance the refresh decision stage takes on one candidate drift entry. Decisions carry no structural coordinates: the assembler derives every opPath/value/evidence deterministically from the diff entry and the fragment copies (design: decisions-first pipeline, 2026-10-29).",
  "type": "object",
  "additionalProperties": false,
  "required": ["diffEntryId", "action"],
  "properties": {
    "diffEntryId": {"type": "string", "minLength": 1},
    "action": {"enum": ["adopt", "skip", "ledger"]},
    "reason": {"type": "string", "minLength": 1},
    "classification": {"enum": ["adopted", "rejected", "deferred", "external"]},
    "fragment": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.json$"},
    "override": {"type": "boolean"},
    "overrideReason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "ledger"}}},
      "then": {"required": ["classification", "reason"]}
    },
    {
      "if": {"properties": {"action": {"const": "skip"}}},
      "then": {"required": ["reason"]}
    },
    {
      "if": {"properties": {"override": {"const": true}}, "required": ["override"]},
      "then": {"required": ["overrideReason"]}
    }
  ]
}
