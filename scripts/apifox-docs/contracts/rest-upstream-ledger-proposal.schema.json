{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.com/contracts/rest-upstream-ledger-proposal.schema.json",
  "title": "REST Upstream Ledger Bootstrap Proposal",
  "description": "Pre-registration proposal derived from a full diff at the pinned upstream commit. Humans edit classifications/reasons before merge; the merge step strips basis and appends ledger-shaped entries to the append-only ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "fromPin", "generatedOn", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "source": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "fromPin": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "generatedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "isoDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "opKey": {"type": "string", "pattern": "^(get|put|post|delete|patch|options|head|trace) /[^\\s]+$"},
    "fragmentFile": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.json$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opKey", "source", "firstSeenPin", "firstSeenAt", "classification", "reason", "owner", "decidedAt", "basis"],
      "properties": {
        "opKey": {"$ref": "#/$defs/opKey"},
        "source": {"$ref": "#/$defs/sourceId"},
        "firstSeenPin": {"$ref": "#/$defs/sha1"},
        "firstSeenAt": {"$ref": "#/$defs/isoDate"},
        "classification": {"enum": ["adopted", "rejected", "deferred", "external"]},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "decidedAt": {"$ref": "#/$defs/isoDate"},
        "fragment": {"$ref": "#/$defs/fragmentFile"},
        "basis": {
          "description": "diff entry ids this proposal was derived from; kept in the proposal for audit, dropped when merged into the ledger",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
